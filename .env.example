# Copy to .env (or set these in the service environment) and adjust.
# Every value is optional; the defaults shown are what the app uses.

# --- Branding / public identity ---
APP_TITLE="DIY Sensor"
BRAND="DIY Sensor"
# Public URL, no trailing slash. Used in the examples printed on the main page,
# so devices can copy a working curl command straight off it.
BASE_URL="https://diy-sensor.org"
# Where the main page's "report a problem" link goes. Empty hides the link.
# FEEDBACK_URL="https://github.com/vektorious/sensor_board/issues"

# --- Mount path ---
# URL prefix the dashboard is served under. The main page lives at "/".
# Set to "" to put the dashboard at the root instead — the main page is then
# not served at all, because the two would collide.
ROOT_PATH="/dashboard"

# --- Ingestion ---
# Devices publish anonymously with a client-chosen write_key and need no key at
# all. API keys are for *operators*: they raise limits and make devices
# permanent. An API key never overrides a device's write key.
# One key:
API_KEY="change-me"
# ...or several (comma-separated) — e.g. one per workshop/group. If set, this
# takes precedence over API_KEY. Any listed key is accepted as x-api-key.
# API_KEYS="workshop-a-key,workshop-b-key,admin-key"
# Map keys to named limit policies. Unmapped valid keys get "trusted".
# API_KEY_POLICIES="workshop-a-key:workshop,admin-key:trusted"
# Set false for a private, API-key-only instance (no anonymous publishing).
# ALLOW_ANONYMOUS=true
# Path devices POST measurements to.
INGEST_PATH="/sensor/measurement"

# --- Limit policies ---
# Two policies exist by default: "anonymous" (unauthenticated) and "trusted"
# (any valid API key). Any name used in API_KEY_POLICIES becomes a policy too,
# starting as a copy of "trusted".
#
# Override one value with POLICY_<NAME>_<FIELD>. A policy may only *raise* a
# limit: non-positive values are refused, and nothing may drop below the
# anonymous baseline. Anonymous defaults are deliberately tight — loosen them
# once real traffic shows what normal looks like.
#
# POLICY_ANONYMOUS_MAX_PAYLOAD_BYTES=16384
# POLICY_ANONYMOUS_MAX_SENSOR_FIELDS_PER_REQUEST=16
# POLICY_ANONYMOUS_MAX_SENSORS_PER_DEVICE=16
# POLICY_ANONYMOUS_MAX_DEVICE_ID_LENGTH=64
# POLICY_ANONYMOUS_MAX_SENSOR_NAME_LENGTH=64
# POLICY_ANONYMOUS_MAX_STRING_VALUE_LENGTH=64
# POLICY_ANONYMOUS_REQUESTS_PER_MINUTE_PER_IP=30
# POLICY_ANONYMOUS_REQUESTS_PER_DAY_PER_IP=1000
# POLICY_ANONYMOUS_WRITES_PER_MINUTE_PER_DEVICE=12
# POLICY_ANONYMOUS_NEW_DEVICES_PER_HOUR_PER_IP=5
# POLICY_ANONYMOUS_ACTIVE_DEVICES_PER_IP=10
# POLICY_ANONYMOUS_WRITES_PER_SECOND=3
# POLICY_ANONYMOUS_WRITE_BURST=300
#
# POLICY_TRUSTED_WRITES_PER_MINUTE_PER_DEVICE=60
# POLICY_TRUSTED_MAX_SENSORS_PER_DEVICE=64

# --- Sizing a workshop ---
# A workshop hands the same API key to every student, and that is what makes it
# different from N independent devices: the write budget is charged per
# *credential*, not per device, and in stored values rather than requests
# (routes/ingest.py passes len(payload.sensors) as the row count). So one shared
# key means one bucket that the whole room draws from:
#
#     rows/s = devices x sensors_per_reading / interval_seconds
#
# 80 devices sending 8 sensors every 5 minutes = 2.1 rows/s, which fits inside
# the 3 rows/s baseline. The same room at a 60 s interval would want 10.7 rows/s
# and would be shed — and because write_burst absorbs the first few minutes, it
# would look healthy during setup and only start failing once everyone was
# publishing steadily. Work the number out before the day, not during it.
#
# Two limits bite at the start rather than in the steady state:
#   - every device claims its ID in the first hour, and trusted allows only 100
#     new devices per hour per IP — a whole class behind one NAT address is
#     close to that before anyone re-flashes;
#   - if they power on together, the first round arrives at once: 80 devices x
#     8 sensors = 640 rows against a burst of 300.
#
# For a class of up to 80 devices reporting every 5 minutes:
# API_KEYS="workshop-2026-key"
# API_KEY_POLICIES="workshop-2026-key:workshop"
# POLICY_WORKSHOP_WRITE_BURST=1000
# POLICY_WORKSHOP_NEW_DEVICES_PER_HOUR_PER_IP=300
# POLICY_WORKSHOP_WRITES_PER_SECOND=6
#
# Devices created with an API key are persistent and are never swept, so they
# outlive the workshop. Clean up afterwards with the key's hash, which is the
# value the ingest log records:
#   python -m app.admin delete-key-data <sha256>

# --- Global budgets (platform-wide, on top of the per-policy ones) ---
# Bounds the write *flow* regardless of who is writing.
# GLOBAL_WRITES_PER_SECOND=10
# GLOBAL_WRITE_BURST=1000

# --- Storage ---
# DB_PATH="/home/USER/sensor_board/app/data/sensors.db"
# Bounds the storage *stock*, in case the flow budget is misconfigured or the
# per-row size estimate is wrong. WARN only logs; MAX makes ingestion return
# 503. Both assume a 10 GB host quota — SCALE THESE TO YOUR ACTUAL QUOTA.
# DB_SIZE_WARN_BYTES=1073741824
# DB_SIZE_MAX_BYTES=2147483648
# Warn when the database grows faster than this (early warning, not a limit).
# DB_GROWTH_WARN_MB_PER_HOUR=50

# --- Retention (automatic cleanup) ---
# A temporary device is deleted once it has gone this long without a successful
# write; its measurements and stored key hash go with it, and the device ID
# becomes free to claim again. Devices created with an API key are permanent.
# Set to 0 to disable expiry entirely.
# RETENTION_HOURS=48
# How often the background sweep runs, in hours.
# RETENTION_SWEEP_INTERVAL_HOURS=1
# Exceptions: comma-separated device IDs and/or project names that are never
# auto-deleted, however long they stay silent. A device is spared if its ID is
# exempt OR its latest project is exempt.
# RETENTION_EXEMPT_DEVICES="reference-station,demo-device-01"
# RETENTION_EXEMPT_PROJECTS="permanent-exhibit"

# --- Reverse proxy ---
# Read by conf.py (gunicorn), not by the app. The address of the proxy in front
# of the app; X-Forwarded-For is trusted ONLY from a listed address, and the
# real client IP is then what the per-IP rate limits key on.
#
# On Uberspace this is the web frontend. To find it, look at access.log before
# this is configured: behind a proxy every request, from every client and every
# network, shows the same address — that one is the proxy. Leave unset to use
# the default below.
#
# NEVER set this to "*": X-Forwarded-For is trivially forged, so trusting it
# from anywhere lets a client pick its own rate-limit identity or spend
# someone else's allowance.
# FORWARDED_ALLOW_IPS="100.65.24.1"

# --- Frontend ---
# Pointing this at a CDN also widens the Content-Security-Policy script-src to
# that origin; leave it vendored to keep the policy at 'self'.
# ECHARTS_SRC="/dashboard/static/js/echarts.min.js"
DEFAULT_RANGE_HOURS=168
